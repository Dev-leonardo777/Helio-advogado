# Copie para .env.local e preencha os dados reais. Nunca versione segredos.
# Dados públicos, incorporados ao bundle: reinicie o dev server ou refaça o build.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp: somente dígitos, com país e DDD, sem + ou espaços.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_OAB_REGISTRATION=

# Segredos e configurações SOMENTE do servidor.
# Resend: chave com permissão de envio e remetente de domínio verificado.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Origem exata do site, sem caminhos; localmente pode ficar vazio.
# Em produção, preencher com a URL HTTPS final.
SITE_URL=
